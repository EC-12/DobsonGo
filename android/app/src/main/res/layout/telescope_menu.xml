<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="0.0dip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageButton
        android:id="@+id/terroroo_fb"
        android:background="@null"
        android:padding="0.0dip"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/menu_icon_round"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/terroroo_floating_menu"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#DD1a1a1a"
        android:padding="0dp"
        android:elevation="12dp"
        android:visibility="visible">

        <!-- 0: Bandeau titre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FF2d2d2d"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/terroroo_connection_status"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="#FFff0000"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GoTo Control"
                android:textColor="#FFffffff"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <ImageButton
                android:id="@+id/terroroo_close_btn"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@null"/>

        </LinearLayout>

        <!-- 1: Main Layout -->
        <LinearLayout
            android:id="@+id/terroroo_main_layout"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- PHASE 1: Scan des appareils BLE -->
            <LinearLayout
                android:id="@+id/terroroo_ble_main_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone" >

                <TextView
                    android:id="@+id/terroroo_connection_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="Télescope non connecté"
                    android:textColor="#FFaaaaaa"
                    android:textSize="16sp"
                    android:layout_marginBottom="15dp"/>

                <!-- Bouton scan/stop -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/terroroo_scan_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Démarrer le scan"
                        android:textColor="#FFffffff"
                        android:background="#FF0066cc"
                        android:textAllCaps="false" />

                    <ImageButton
                        android:id="@+id/terroroo_edit_connkey_btn"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_menu_edit"
                        android:background="@null"
                        android:layout_marginStart="5dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/terroroo_connkey_layout"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone" >

                    <EditText
                        android:id="@+id/terroroo_connkey_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#DD1a1a1a"
                        android:hint="Clé de connexion"
                        android:inputType="textNoSuggestions"
                        android:imeOptions="actionDone"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textColor="#FFaaaaaa"
                        android:textColorHint="#FFaaaaaa"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/terroroo_validate_connkey_btn"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_menu_add"
                        android:background="@null"
                        android:layout_marginStart="5dp" />

                </LinearLayout>

                <!-- Liste des appareils trouvés -->
                <view class="com.terroroo.dobsongomenu.UIController$ScrollableLayout"
                    android:id="@+id/terroroo_ble_list"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:scrollable_max_height="200dp"
                    app:scrollable_title="Appareils Trouvés :"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- PHASE 2: Infos télescope + focale (visible si connecté) + mode de sélection -->
            <LinearLayout
                android:id="@+id/terroroo_telescope_info_layout"
                android:layout_width="match_parent"
                android:background="#FF252525"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible" >

                <!-- Bandeau infos télescope -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp" >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Modèle :"
                            android:textColor="#FF888888"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/terroroo_telescope_model"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFffffff"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Batterie :"
                            android:textColor="#FF888888"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/terroroo_telescope_battery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--%"
                            android:textColor="#FF00ff00"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Az :"
                            android:textColor="#FF888888"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/terroroo_telescope_azm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFffffff"
                            android:layout_marginEnd="64dp"
                            android:text="--°"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Alt :"
                            android:textColor="#FF888888"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/terroroo_telescope_alt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFffffff"
                            android:text="--°"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="2dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="#FF444444"/>

                <!-- Paramètres du télescope -->
                <view class="com.terroroo.dobsongomenu.UIController$SubMenuLayout"
                    android:id="@+id/terroroo_settings_sub_menu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:sub_menu_title="Paramètres du télescope" >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:orientation="horizontal" >

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@android:drawable/ic_menu_preferences"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textStyle="bold"
                            android:text="Paramètres du télescope"
                            android:textColor="#FF888888"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:text="➤"
                            android:textColor="#FF888888"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="6dp" >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Focale oculaire (mm)"
                            android:textColor="#FFaaaaaa"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginBottom="4dp">

                            <EditText
                                android:id="@+id/terroroo_eyepiece_focal_input"
                                android:layout_width="wrap_content"
                                android:layout_weight="1"
                                android:layout_height="32dp"
                                android:background="#DD1a1a1a"
                                android:hint="Ex: 10"
                                android:inputType="numberDecimal"
                                android:imeOptions="actionDone"
                                android:paddingLeft="12dp"
                                android:paddingRight="12dp"
                                android:textColor="#FFaaaaaa"
                                android:textColorHint="#FFaaaaaa"
                                android:textSize="14sp" />

                            <ImageButton
                                android:id="@+id/terroroo_edit_focal_btn"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@android:drawable/ic_menu_edit"
                                android:src="@null"
                                android:layout_marginStart="5dp" />
                        </LinearLayout>
                    </LinearLayout>
                </view>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="3dp"
                    android:background="#FF444444"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FF323232"
                    android:orientation="vertical"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="12dp">

                    <view class="com.terroroo.dobsongomenu.UIController$SubMenuLayout"
                        android:id="@+id/terroroo_horizons_add_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:sub_menu_title="menu horizons">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:textColor="#FFF"
                                android:textAlignment="center"
                                android:gravity="center"
                                android:textSize="13sp"
                                android:padding="8dp"
                                android:text="+ Ajouter un objet Horizons"
                                android:background="#FF0066CC" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="4dp"
                            android:layout_marginBottom="2dp"
                            android:paddingHorizontal="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:text="Nasa JPL Horizons"
                                android:textColor="#FFaaaaaa"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:gravity="center">

                                <EditText
                                    android:id="@+id/terroroo_horizons_search_input"
                                    android:layout_width="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_height="32dp"
                                    android:background="#DD1a1a1a"
                                    android:hint="Ex: Mars, 240P/NEAT..."
                                    android:inputType="textNoSuggestions"
                                    android:imeOptions="actionDone"
                                    android:paddingLeft="12dp"
                                    android:paddingRight="12dp"
                                    android:textColor="#FFaaaaaa"
                                    android:textColorHint="#FFaaaaaa"
                                    android:textSize="14sp" />

                                <ImageButton
                                    android:id="@+id/terroroo_edit_horizons_search_btn"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:background="@android:drawable/ic_menu_edit"
                                    android:src="@null"
                                    android:layout_marginStart="5dp" />

                            </LinearLayout>

                            <!-- Liste des objets trouvés -->
                            <view class="com.terroroo.dobsongomenu.UIController$ScrollableLayout"
                                android:id="@+id/terroroo_horizons_list"
                                android:layout_marginTop="10dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:scrollable_max_height="150dp"
                                app:scrollable_title="Résultats :"
                                android:visibility="gone" />
                        </LinearLayout>
                    </view>

                    <TextView
                        android:id="@+id/terroroo_add_object_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="#FFF"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:padding="8dp"
                        android:clickable="true"
                        android:background="#9900FF00"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FF444444"/>

                <LinearLayout
                    android:id="@+id/terroroo_queue_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="12dp" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FF888888"
                        android:textAlignment="textStart"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:text="file d'attente"
                        android:layout_marginEnd="8dp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:background="@android:color/transparent" />

                    <!--#9900FF00-->
                    <TextView
                        android:id="@+id/terroroo_queue_title_number"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#FF888888"
                        android:textAlignment="textStart"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:text="(0)"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <!-- Menu sélection de vue -->
                <!--view class="com.terroroo.dobsongomenu.UIController$SelectionMenu"
                    android:id="@+id/terroroo_view_selection_menu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FF333333"
                    android:layout_margin="4dp"
                    android:padding="4dp"
                    android:gravity="center" >
                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Recherche  Horizons" />

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Vue  Courante" />
                </view-->
            </LinearLayout>

            <!-- Séparateur -->
            <View
                android:id="@+id/terroroo_separator_34"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FF444444"
                android:visibility="gone" />

            <!-- PHASE 4: Infos objet spatial + tracking (visible si objet sélectionné) -->
            <view class="com.terroroo.dobsongomenu.UIController$ObjectTrackerLayout"
                android:id="@+id/terroroo_object_tracking_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="2dp"
                android:layout_marginBottom="2dp"
                android:paddingHorizontal="8dp"
                android:visibility="gone" >
            </view>

            <!-- Séparateur -->
            <View
                android:id="@+id/terroroo_separator_45"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FF444444"
                android:visibility="gone" />

            <!-- PHASE 5: Erreur de traitement objet -->
            <LinearLayout
                android:id="@+id/terroroo_track_error_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FF252525"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:paddingHorizontal="12dp"
                android:visibility="gone" >

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFeaa2a2"
                    android:layout_marginEnd="8dp"
                    android:background="@android:drawable/stat_sys_warning" />

                <TextView
                    android:id="@+id/terroroo_track_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="textStart"
                    android:textStyle="bold"
                    android:textColor="#FFeaa2a2"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>